---
import Layout from "../layouts/Layout.astro";

// Public domain scans, via Wikimedia Commons. Local copies resized to 1000px.
const historicalMaps = [
    {
        img: "babylonian-world-map-600bce",
        commons: "Babylonian Map of the World, 700-500 BC.jpg",
        title: "Babylonian Map of the World",
        meta: "Sippar, Mesopotamia · c. 600 BCE",
        note: "The oldest known map of the world, on a clay tablet: Babylon and the Euphrates at the center, ringed by a \u201cbitter river\u201d ocean, with mythic lands pointing outward like a star.",
    },
    {
        img: "turin-papyrus-1150bce",
        commons: "Turin Papyrus (geological map) - Museo Egizio Turin C 1879 1969 1899 p01.jpg",
        title: "Turin Papyrus Map",
        meta: "Egypt · c. 1150 BCE",
        note: "Drawn by the scribe Amennakhte for a quarrying expedition under Ramesses IV. Pink hills, roads, a gold mine, and the stone quarry make it the oldest surviving geological map.",
    },
    {
        img: "yu-ji-tu-1136",
        commons: "Yuji tu - BEFEO.png",
        title: "Yu Ji Tu (Map of the Tracks of Yu)",
        meta: "Song dynasty China · 1136",
        note: "Carved in stone on a grid where each square is 100 li. China's rivers and coast are startlingly accurate, centuries before Europe drew to scale on a grid.",
    },
    {
        img: "tabula-rogeriana-1154",
        commons: "TabulaRogeriana.jpg",
        title: "Tabula Rogeriana",
        meta: "Muhammad al-Idrisi · 1154",
        note: "Drawn for Roger II of Sicily from Arab, Greek, and travelers' accounts, with south at the top. For three centuries it was among the most accurate world maps anywhere. Shown in Konrad Miller's 1928 reconstruction.",
    },
    {
        img: "catalan-atlas-1375",
        commons: "1375 Atlas Catalan Abraham Cresques.jpg",
        title: "Catalan Atlas",
        meta: "Abraham and Jehuda Cresques · 1375",
        note: "The masterpiece of the Majorcan portolan school: compass-rose rhumb lines for sailors, plus Mansa Musa of Mali holding a gold nugget, a reminder of what Europe knew about African wealth.",
    },
    {
        img: "kangnido-1402",
        commons: "GeneralMapOfDistancesAndHistoricCapitals.jpg",
        title: "Kangnido",
        meta: "Joseon Korea · 1402 (copy, late 1400s)",
        note: "One of the oldest surviving world maps from East Asia, made in Korea from Chinese and Islamic sources. Korea is drawn oversized and Africa appears decades before Europeans rounded the Cape.",
    },
    {
        img: "waldseemuller-1507",
        commons: "Waldseemuller map 2.jpg",
        title: "Universalis Cosmographia",
        meta: "Martin Waldseemüller · 1507",
        note: "The first map to print the name “America.” The Library of Congress bought the only known copy for $10 million and calls it America's birth certificate.",
    },
    {
        img: "piri-reis-1513",
        commons: "Piri reis world map 01.jpg",
        title: "Piri Reis Map",
        meta: "Ottoman Empire · 1513",
        note: "The Ottoman admiral Piri Reis compiled it on gazelle skin from some twenty sources, including a now-lost map by Columbus. It is one of the earliest surviving maps to show the Americas.",
    },
    {
        img: "codex-mendoza-1541",
        commons: "Codex Mendoza folio 2r.jpg",
        title: "Founding of Tenochtitlan, Codex Mendoza",
        meta: "Mexica painters, New Spain · c. 1541",
        note: "Part map, part history: the island city split into four quarters by canals, with the eagle on the cactus at its heart. That eagle is on Mexico's flag today.",
    },
    {
        img: "mercator-1569",
        commons: "Mercator 1569 world map composite.jpg",
        title: "Nova et Aucta Orbis Terrae",
        meta: "Gerardus Mercator · 1569",
        note: "Built so that a straight line is a constant compass bearing, which made it perfect for navigation and terrible for comparing areas. Greenland's bloat starts here.",
    },
    {
        img: "halley-trade-winds-1686",
        commons: "Edmond Halley's map of the trade winds, 1686.jpg",
        title: "Map of the Trade Winds",
        meta: "Edmond Halley · 1686",
        note: "Often called the first meteorological map. Halley drew wind direction with rows of short strokes, an early ancestor of every vector-field and streamline map since.",
    },
    {
        img: "nolli-rome-1748",
        commons: "Nuova pianta di Roma data in luce da Giambattista Nolli l’anno MDCCXLVII, known as La Pianta Grande di Roma (IA clevelandart-2020.276-nuova-pianta-di-roma).tif",
        title: "La Pianta Grande di Roma",
        meta: "Giambattista Nolli · 1748",
        note: "Twelve engraved plates that render public interiors (churches, courtyards) as white like the streets, and private buildings as dark. Architects still use “Nolli maps” to show public space.",
    },
    {
        img: "tupaia-chart-1769",
        commons: "Tupaia's map, c. 1769.jpg",
        title: "Tupaia's Chart",
        meta: "Tupaia of Ra\u02bbiātea, with Cook's crew · 1769",
        note: "A Polynesian navigator-priest mapped dozens of Pacific islands for the Endeavour. Scholars now read it as a map of sailing relationships from where you stand, not a grid seen from above.",
    },
    {
        img: "jambudvipa-1800",
        commons: "Jain Cosmological Map of the Universe - Jambudvipa.jpg",
        title: "Jambudvipa",
        meta: "Jain cosmological painting, India · c. 1800",
        note: "Concentric continents and oceans around Mount Meru, the world of humans in Jain cosmology. A reminder that maps can chart a belief as precisely as a coastline.",
    },
    {
        img: "smith-geology-1815",
        commons: "Geological map Britain William Smith 1815.jpg",
        title: "A Delineation of the Strata of England and Wales",
        meta: "William Smith · 1815",
        note: "The first geological map of an entire country, hand-colored rock layer by rock layer by a self-taught canal surveyor. Simon Winchester called it the map that changed the world.",
    },
    {
        img: "ino-japan-1821",
        commons: "1878 Meiji 11 Ino Tadataka Japanese Military Map of Japan - Geographicus - Japan-ino-1878.jpg",
        title: "Maps of Japan's Coastline",
        meta: "Inō Tadataka · surveyed 1800–1816 (this edition 1878)",
        note: "A retired merchant began surveying at 55 and walked about 35,000 km of coast. His maps stayed Japan's standard for decades; this Meiji military edition is built on them.",
    },
    {
        img: "dupin-instruction-1826",
        commons: "Carte figurative de l'instruction populaire de la France - Collon, del. - btv1b530830640.jpg",
        title: "Carte figurative de l'instruction populaire",
        meta: "Charles Dupin · 1826",
        note: "The first choropleth map: French departments shaded darker where fewer children went to school. Every county-by-county map you have ever seen descends from this one.",
    },
    {
        img: "nicollet-upper-mississippi-1843",
        commons: "Hydrographical Basin of the Upper Mississippi River - From Astronomical and Barometrical Observations Surveys and (IA dr hydrographical-basin-of-the-upper-mississippi-river-from-astronomical-and-13071000).jpg",
        title: "Hydrographical Basin of the Upper Mississippi River",
        meta: "Joseph N. Nicollet · 1843",
        note: "Our home map. Nicollet's surveys of 1836 to 1839 produced the first accurate map of what became Minnesota, and it records many Dakota and Ojibwe place names. Yes, that Nicollet.",
    },
    {
        img: "snow-cholera-1854",
        commons: "Snow-cholera-map-1.jpg",
        title: "Cholera in Soho",
        meta: "John Snow · 1854",
        note: "Stacked bars mark each death around the Broad Street pump. Snow had already made his case before drawing it, but the map became the founding image of epidemiology and spatial analysis.",
    },
    {
        img: "minard-napoleon-1869",
        commons: "Minard.png",
        title: "Napoleon's March on Moscow",
        meta: "Charles Joseph Minard · 1869",
        note: "Six variables on one sheet: army size, latitude and longitude, direction, temperature, and dates. Edward Tufte called it possibly the best statistical graphic ever drawn.",
    },
    {
        img: "ammassalik-wooden-maps-1885",
        commons: "Holm1887p250 Trækort.png",
        title: "Ammassalik Wooden Maps",
        meta: "Kunit, Tasiilaq, Greenland · c. 1885",
        note: "Carved driftwood coastlines, read by touch. They work in the dark and in mittens, and they float if you drop them from a kayak. Shown in the 1887 drawing from Gustav Holm's expedition report.",
    },
    {
        img: "sanborn-minneapolis-1885",
        commons: "Sanborn Fire Insurance Map from Minneapolis, Hennepin County, Minnesota, Volume 2, 1885, Plate 0057L.jpg",
        title: "Sanborn Fire Insurance Map of Minneapolis",
        meta: "Sanborn Map Company · 1885",
        note: "St. Anthony Falls, Hennepin Island, and the Pillsbury A Mill, drawn building by building. Colors code construction (pink for brick, yellow for wood) so insurers could price fire risk.",
    },
    {
        img: "booth-poverty-1898",
        commons: "London Poverty Map, 1898-9 - Sheet 01 - eastern district - lse-library-yzrdcOgEs6c-unsplash.jpg",
        title: "Map Descriptive of London Poverty",
        meta: "Charles Booth · 1898–99",
        note: "Every street colored by household income in seven classes, from black (“lowest class”) to yellow (“wealthy”), built from street-by-street survey work. A direct ancestor of today's choropleth. Shown: the East End sheet.",
    },
    {
        img: "marshall-stick-chart",
        commons: "Marshall Islands stick chart, Rebbelib type. LOC 2010586182.jpg",
        title: "Marshall Islands Stick Chart",
        meta: "Marshall Islands · tradition centuries old (this example c. 1920)",
        note: "Palm ribs trace how ocean swells bend around islands, and shells mark the islands. Navigators memorized the charts on land and read the waves with their bodies at sea.",
    },
];

const commonsUrl = (file: string) =>
    "https://commons.wikimedia.org/wiki/File:" +
    encodeURIComponent(file.replace(/ /g, "_"));

const resources = [
    {
        heading: "Twin Cities and Minnesota map data",
        items: [
            {
                name: "Minnesota Geospatial Commons",
                url: "https://gisdata.mn.gov/",
                note: "The state's clearinghouse for GIS data: boundaries, land cover, lakes, roads, and Met Council layers. Start here for anything statewide.",
            },
            {
                name: "Open Data Minneapolis",
                url: "https://opendata.minneapolismn.gov/",
                note: "City datasets with locations attached: 311 calls, police incidents, the tree inventory, building permits, parcels.",
            },
            {
                name: "Saint Paul Open Information",
                url: "https://information.stpaul.gov/",
                note: "The St. Paul equivalent, including district council boundaries and city service data.",
            },
            {
                name: "Hennepin County GIS Open Data",
                url: "https://gis-hennepin.hub.arcgis.com/",
                note: "Parcels, property values, elections, and county infrastructure, downloadable as shapefiles or GeoJSON.",
            },
            {
                name: "MnTOPO (Minnesota DNR)",
                url: "https://arcgis.dnr.state.mn.us/maps/mntopo/",
                note: "Statewide high-resolution lidar elevation in the browser. Good for seeing the river bluffs, old channels, and how flat the city really is.",
            },
        ],
    },
    {
        heading: "Local history through maps",
        items: [
            {
                name: "Mapping Prejudice (University of Minnesota)",
                url: "https://mappingprejudice.umn.edu/",
                note: "Volunteers have read thousands of property deeds to map the racial covenants that shaped Minneapolis neighborhoods. A model of community-built map data.",
            },
            {
                name: "Minnesota Historical Aerial Photographs Online",
                url: "https://apps.lib.umn.edu/mhapo/",
                note: "Historical aerial photos of the whole state. Find your block before the freeways.",
            },
            {
                name: "John R. Borchert Map Library",
                url: "https://www.lib.umn.edu/borchert",
                note: "The University of Minnesota's map library, open to the public, with historical maps, atlases, and staff who love questions.",
            },
            {
                name: "Native Land Digital",
                url: "https://native-land.ca/",
                note: "An interactive map of Indigenous territories, languages, and treaties. The Twin Cities sit on Dakota land, Mni Sota Makoce.",
            },
        ],
    },
    {
        heading: "Historical map collections",
        items: [
            {
                name: "David Rumsey Map Collection",
                url: "https://www.davidrumsey.com/",
                note: "More than 100,000 high-resolution scans, many georeferenced so you can lay old maps over modern ones.",
            },
            {
                name: "Library of Congress: Maps",
                url: "https://www.loc.gov/maps/",
                note: "Free downloads of a huge collection, including Sanborn fire insurance maps of Minneapolis and St. Paul, drawn building by building.",
            },
            {
                name: "Leventhal Map & Education Center",
                url: "https://www.leventhalmap.org/",
                note: "Boston Public Library's map center, with an excellent digital collection and thoughtful online exhibitions on maps and power.",
            },
        ],
    },
    {
        heading: "Tools for making maps",
        items: [
            {
                name: "Datawrapper",
                url: "https://www.datawrapper.de/maps",
                note: "The fastest path from a spreadsheet to a clean choropleth or symbol map. Free, no code, newsroom quality.",
            },
            {
                name: "Felt",
                url: "https://felt.com/",
                note: "Collaborative web mapping. Drop in a file, draw, annotate, and share a link. Friendly for first-timers.",
            },
            {
                name: "QGIS",
                url: "https://qgis.org/",
                note: "Free, open-source, full desktop GIS. Steeper learning curve, but it can do nearly anything the expensive software does.",
            },
            {
                name: "geojson.io",
                url: "https://geojson.io/",
                note: "Draw points, lines, and shapes on a map and export them as GeoJSON. Great for making your own small dataset.",
            },
            {
                name: "Mapshaper",
                url: "https://mapshaper.org/",
                note: "Simplify, clip, and convert shapefiles and GeoJSON in the browser. Fixes the file that is too big to load.",
            },
            {
                name: "kepler.gl",
                url: "https://kepler.gl/",
                note: "Uber's open-source tool for big point datasets: hexbins, arcs, and time animation, all in the browser.",
            },
            {
                name: "OpenStreetMap",
                url: "https://www.openstreetmap.org/",
                note: "The free, volunteer-built map of the world. Both a basemap and a dataset, and you can edit your own neighborhood.",
            },
            {
                name: "Natural Earth",
                url: "https://www.naturalearthdata.com/",
                note: "Public domain country, state, river, and coastline shapes at three scales. The default source for world maps.",
            },
        ],
    },
    {
        heading: "Color, projection, and design",
        items: [
            {
                name: "ColorBrewer",
                url: "https://colorbrewer2.org/",
                note: "Cynthia Brewer's color schemes for maps: sequential, diverging, and qualitative, with colorblind-safe and print-safe filters.",
            },
            {
                name: "The True Size Of",
                url: "https://www.thetruesize.com/",
                note: "Drag countries around a Mercator map and watch them shrink or grow. The fastest argument about projections there is.",
            },
            {
                name: "Jason Davies: Maps",
                url: "https://www.jasondavies.com/maps/",
                note: "Interactive projection experiments built with D3: transitions between projections, interrupted globes, and more.",
            },
            {
                name: "xkcd: Map Projections",
                url: "https://xkcd.com/977/",
                note: "“What your favorite map projection says about you.” Funny and, for a cartoon, accurate.",
            },
            {
                name: "Atlas of Design",
                url: "https://atlasofdesign.org/",
                note: "A juried collection of beautiful maps from the North American Cartographic Information Society. Browse for inspiration.",
            },
        ],
    },
    {
        heading: "Books",
        items: [
            {
                name: "How to Lie with Maps, Mark Monmonier",
                note: "The classic on how projection, generalization, and color choices shape what a map says. Short, funny, and essential.",
            },
            {
                name: "Everything Sings: Maps for a Narrative Atlas, Denis Wood",
                note: "A whole neighborhood in Raleigh mapped by its jack-o'-lanterns, streetlight pools, and radio waves. Proof that anything can be a map.",
            },
            {
                name: "This Is Not an Atlas, kollektiv orangotango+",
                note: "Counter-cartography from activists and communities around the world, mapping to resist rather than to rule. Free to read online.",
            },
            {
                name: "Cartography., Kenneth Field",
                note: "A beautifully designed A to Z reference on making good maps, written for people who make them.",
            },
        ],
    },
];
---

<Layout
    title="Mapathon: All About Maps | tcplot: Data Visualization in Minneapolis and St. Paul"
    description="Bring a map you love, then build one together and present what you made."
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="max-w-4xl mx-auto mt-8 mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">
                Upcoming: Mapathon — All About Maps
            </h2>

            <div class="mb-6 text-gray-700">
                <p class="text-lg font-semibold text-gray-900">
                    Saturday, Oct 24 · 10:00 AM to 12:00 PM CDT
                </p>
                <p class="flex items-start gap-2 mt-1">
                    <svg
                        class="w-5 h-5 mt-0.5 shrink-0 text-gray-400"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12 2c-3.866 0-7 3.07-7 6.857 0 4.34 4.686 9.86 6.412 11.74a.8.8 0 0 0 1.176 0C14.314 18.717 19 13.197 19 8.857 19 5.07 15.866 2 12 2Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <span
                        ><span class="font-semibold text-gray-900"
                            >The Coffee Shop NE</span
                        ><br />2852 Johnson St NE · Minneapolis, MN</span
                    >
                </p>
            </div>

            <p class="text-xl text-gray-600 leading-relaxed mb-4"></p>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                Join tcplot for a morning devoted entirely to maps, in two
                acts.
            </p>

            <div class="flex justify-center mt-12 mb-8">
                <div class="max-w-2xl w-full">
                    <div class="rounded-lg overflow-hidden">
                        <img
                            src="/images/meiji-japan-prefecture-map-1870s.jpg"
                            alt="A Meiji-era outline map of Japan with prefectures hand-tinted in soft green, orange, yellow, and purple"
                            class="w-full h-auto object-contain"
                        />
                    </div>
                    <p class="text-sm text-gray-500 leading-relaxed mt-2">
                        A Meiji-era outline map of Japan (大日本暗射地図,
                        1870s), the newly drawn prefectures hand-tinted in
                        watercolor.
                    </p>
                </div>
            </div>

            <h3 class="text-2xl font-semibold text-gray-900 mb-3">
                Act one: bring a map
            </h3>
            <p class="text-lg text-gray-600 leading-relaxed mb-8">
                Your ticket in is one map, any map, and two minutes on why it's
                great (or gloriously terrible) — a classic like Minard or Snow's
                cholera map, an interactive you keep going back to, a paper map
                with a history, something you made yourself, or a bad map you
                love to hate. By the end of the round you'll have seen thirty
                maps and stolen ideas from most of them.
            </p>

            <h3 class="text-2xl font-semibold text-gray-900 mb-3">
                Act two: build together
            </h3>
            <p class="text-lg text-gray-600 leading-relaxed mb-4">
                After a short primer on the modern mapping stack, work solo or
                in small groups to make a map — of your neighborhood, your
                commute, the Twin Cities, anywhere — then present what you made.
                A half-built map with a good idea beats a finished default.
            </p>
            <p class="text-lg font-semibold text-gray-900 mb-2">
                Pick your lane:
            </p>
            <ul class="space-y-2 text-lg text-gray-600 mb-6 list-disc pl-6">
                <li>
                    <span class="font-semibold text-gray-900">Fast and no-code</span>
                    — Datawrapper, Felt, kepler.gl
                </li>
                <li>
                    <span class="font-semibold text-gray-900">Web code</span> —
                    Leaflet, MapLibre GL, deck.gl, D3
                </li>
                <li>
                    <span class="font-semibold text-gray-900">Analysis-first</span>
                    — QGIS, GeoPandas + Folium
                </li>
                <li>
                    <span class="font-semibold text-gray-900">Analog</span> —
                    hand-drawn cartography is a real and honorable lane
                </li>
            </ul>
            <p class="text-lg text-gray-600 leading-relaxed mb-8">
                We'll have a starter list of local open geodata ready to map:
                the Minneapolis tree inventory, bike lanes and scooter trips,
                the Minnesota Geospatial Commons, Metro Transit's GTFS feed,
                OpenStreetMap, or your own GPS traces.
            </p>

            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                No GIS experience needed — the primer starts from zero, and AI
                assistants are welcome (they're good at GeoJSON plumbing). Bring
                one map you love (on a phone, a laptop, or paper) and, if you
                want to build digitally, a laptop.
            </p>

            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                RSVP on <a
                    href="https://www.meetup.com/tcplot/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:underline">Meetup</a
                >.
            </p>

            <p class="text-lg text-gray-600 leading-relaxed">
                Hope to see you there!
            </p>
        </div>

        <div class="border-t border-gray-200 pt-12 mb-16">
            <div class="max-w-4xl mx-auto mb-8">
                <h3 class="text-2xl font-semibold text-gray-900 mb-3">
                    Twenty-Four Maps That Changed How We See
                </h3>
                <p class="text-lg text-gray-600 leading-relaxed">
                    A short, opinionated tour of public domain maps from all
                    over the world, from a Babylonian clay tablet to the first
                    maps of data. Click
                    any map for the full-resolution scan.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    historicalMaps.map((m) => (
                        <figure class="flex flex-col">
                            <a
                                href={commonsUrl(m.commons)}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block rounded-lg overflow-hidden bg-gray-100 aspect-[4/3]"
                            >
                                <img
                                    src={`/images/historical-maps/${m.img}.jpg`}
                                    alt={`${m.title}, ${m.meta}`}
                                    loading="lazy"
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                />
                            </a>
                            <figcaption class="mt-3">
                                <p class="font-semibold text-gray-900">
                                    {m.title}
                                </p>
                                <p class="text-sm text-gray-500 mb-1">
                                    {m.meta}
                                </p>
                                <p class="text-sm text-gray-600 leading-relaxed">
                                    {m.note}
                                </p>
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
            <p class="max-w-4xl mx-auto text-sm text-gray-500 mt-8">
                All images are public domain scans via Wikimedia Commons.
            </p>
        </div>

        <div class="max-w-4xl mx-auto border-t border-gray-200 pt-12 mb-12">
            <h3 class="text-2xl font-semibold text-gray-900 mb-3">
                Resources
            </h3>
            <p class="text-lg text-gray-600 leading-relaxed mb-8">
                Where to find map data for the Twin Cities, tools to make your
                own maps, and some favorite reading.
            </p>

            {
                resources.map((group) => (
                    <div class="mb-10">
                        <h4 class="text-xl font-semibold text-gray-900 mb-4">
                            {group.heading}
                        </h4>
                        <ul class="space-y-3 text-gray-600">
                            {group.items.map((r) => (
                                <li>
                                    {r.url ? (
                                        <a
                                            href={r.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-semibold text-blue-600 hover:underline"
                                        >
                                            {r.name}
                                        </a>
                                    ) : (
                                        <span class="font-semibold text-gray-900">
                                            {r.name}
                                        </span>
                                    )}
                                    <span class="block">{r.note}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</Layout>
