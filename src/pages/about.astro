---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="About | tcplot: Data Visualization in Minneapolis and St. Paul"
    description="About tcplot — a Minneapolis data visualization community for creative coders, analysts, and artists."
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="max-w-4xl mx-auto mt-8 mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">About</h2>

            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                <span class="font-silkscreen">tcplot</span> is a place to learn from
                one another, share work in progress, and explore what's possible when
                data, code, and craft come together. Whether you make charts for a
                living, write code for fun, or work with data as a medium for art,
                you're welcome here.
            </p>

            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                Come to an <a
                    href="https://www.meetup.com/tcplot/?eventOrigin=home_groups_you_organize"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:underline">event</a
                >, follow along on <a
                    href="https://www.instagram.com/tcplot/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:underline">Instagram</a
                >, or reach out at <a
                    href="mailto:clairenyquist@gmail.com"
                    class="text-blue-600 hover:underline"
                    >clairenyquist@gmail.com</a
                >.
            </p>

            <div
                id="p5-playground"
                class="relative w-full rounded-xl overflow-hidden shadow-lg ring-1 ring-black/10 cursor-pointer select-none bg-white"
                style="touch-action: manipulation;"
            >
            </div>
            <p class="mt-3 mb-10 text-sm text-gray-400 text-center italic">
                click the scene to hatch a baby axolotl
            </p>
        </div>
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/p5@1.9.4/lib/p5.min.js"
    ></script>
    <script is:inline>
        (function () {
            const mount = document.getElementById("p5-playground");
            if (!mount || typeof window.p5 === "undefined") return;

            const sketch = (p) => {
                let W, H;
                let axolotls = [];
                const MAX_AXOLOTLS = 14;

                const rand = (a, b) => p.random(a, b);

                function sizeToContainer() {
                    W = mount.clientWidth || 640;
                    H = Math.max(
                        340,
                        Math.min(500, Math.round(window.innerHeight * 0.6)),
                    );
                }

                class Axolotl {
                    constructor(x, y, scale) {
                        this.x = x === undefined ? rand(40, W - 40) : x;
                        this.y = y === undefined ? rand(40, H - 40) : y;
                        this.adultScale = rand(2.0, 2.7);
                        // babies are born small and grow with time
                        this.scale = scale === undefined ? this.adultScale : scale;
                        this.angle = rand(0, p.TWO_PI);
                        this.speed = rand(0.7, 1.4);
                        this.t = rand(0, 1000);
                        this.nseed = rand(0, 1000);
                        // mostly leucistic pink, occasionally wild-type dusk
                        // every axolotl its own pink, pale blush to deep rose
                        this.bodyHue = rand(325, 355);
                        this.bodySat = rand(25, 80);
                        this.bodyBri = rand(58, 100);
                        this.gillHue = rand(342, 356);
                        this.n = 12;
                        this.pts = [];
                        for (let i = 0; i <= this.n; i++)
                            this.pts.push({ x: this.x, y: this.y + i * this.segLen() });
                    }
                    segLen() {
                        return 7.5 * this.scale;
                    }
                    shift(dx, dy) {
                        this.x += dx;
                        this.y += dy;
                        for (const pt of this.pts) {
                            pt.x += dx;
                            pt.y += dy;
                        }
                    }
                    update() {
                        if (this.scale < this.adultScale)
                            this.scale = Math.min(
                                this.adultScale,
                                this.scale + 0.0009,
                            );

                        this.t += 0.02;
                        const steer =
                            (p.noise(this.nseed, this.t * 0.5) - 0.5) * 0.3;
                        this.angle += steer;
                        const wiggle = Math.sin(this.t * 6) * 0.24; // gentle swim
                        const heading = this.angle + wiggle;
                        const spd = this.speed * (0.55 + 0.45 * this.scale);
                        this.x += Math.cos(heading) * spd;
                        this.y += Math.sin(heading) * spd;

                        const m = 90;
                        if (this.x < -m) this.shift(W + 2 * m, 0);
                        if (this.x > W + m) this.shift(-(W + 2 * m), 0);
                        if (this.y < -m) this.shift(0, H + 2 * m);
                        if (this.y > H + m) this.shift(0, -(H + 2 * m));

                        this.pts[0].x = this.x;
                        this.pts[0].y = this.y;
                        for (let i = 1; i <= this.n; i++) {
                            const a = this.pts[i - 1],
                                b = this.pts[i];
                            let dx = b.x - a.x,
                                dy = b.y - a.y;
                            const d = Math.hypot(dx, dy) || 0.0001;
                            dx /= d;
                            dy /= d;
                            b.x = a.x + dx * this.segLen();
                            b.y = a.y + dy * this.segLen();
                        }
                    }
                    legPair(idx, phase) {
                        const a = this.pts[idx - 1],
                            b = this.pts[idx + 1] || this.pts[idx];
                        let hx = b.x - a.x,
                            hy = b.y - a.y;
                        const d = Math.hypot(hx, hy) || 0.0001;
                        hx /= d;
                        hy /= d;
                        const px = -hy,
                            py = hx;
                        const c = this.pts[idx];
                        const swing = Math.sin(this.t * 7 + phase) * 5 * this.scale;
                        const len = 13 * this.scale; // proper axolotl legs
                        for (const side of [1, -1]) {
                            const fx = c.x + px * side * len + hx * swing;
                            const fy = c.y + py * side * len + hy * swing;
                            const kx = c.x + px * side * len * 0.5;
                            const ky = c.y + py * side * len * 0.5;
                            p.line(c.x, c.y, kx, ky);
                            p.line(kx, ky, fx, fy);
                            p.push();
                            p.noStroke();
                            p.fill(this.bodyHue, this.bodySat + 10, this.bodyBri * 0.92, 0.9);
                            p.circle(fx, fy, 4.6 * this.scale);
                            p.pop();
                        }
                    }
                    draw() {
                        const head = this.pts[0],
                            nk = this.pts[1];
                        let hx = head.x - nk.x,
                            hy = head.y - nk.y;
                        const d = Math.hypot(hx, hy) || 0.0001;
                        hx /= d;
                        hy /= d;
                        const px = -hy,
                            py = hx;

                        p.drawingContext.shadowBlur = 10;
                        p.drawingContext.shadowColor = p
                            .color(this.gillHue, 40, 100, 0.8)
                            .toString();

                        // tail fin: translucent membrane along the back half
                        p.noStroke();
                        for (let i = Math.floor(this.n * 0.45); i <= this.n; i++) {
                            const r =
                                p.map(i, 0, this.n, 9, 2) * this.scale * 1.9;
                            p.fill(this.bodyHue, this.bodySat + 8, this.bodyBri, 0.22);
                            p.circle(this.pts[i].x, this.pts[i].y, r * 2);
                        }

                        // legs
                        p.stroke(this.bodyHue, this.bodySat + 10, this.bodyBri * 0.92, 0.9);
                        p.strokeWeight(3.6 * this.scale);
                        this.legPair(3, 0);
                        this.legPair(8, p.PI);

                        // body (tail -> head), tapering circles
                        p.noStroke();
                        for (let i = this.n; i >= 0; i--) {
                            const r = p.map(i, 0, this.n, 10, 2.2) * this.scale;
                            p.fill(this.bodyHue, this.bodySat, this.bodyBri, 1);
                            p.circle(this.pts[i].x, this.pts[i].y, r * 2);
                        }
                        // wide rounded head
                        p.fill(this.bodyHue, this.bodySat, this.bodyBri, 1);
                        p.ellipse(head.x, head.y, 22 * this.scale, 18 * this.scale);

                        // external gills: three feathery stalks per side
                        p.stroke(this.gillHue, 75, 100, 0.95);
                        p.strokeWeight(1.8 * this.scale);
                        for (const side of [1, -1]) {
                            for (let g = 0; g < 3; g++) {
                                const spread = 0.55 + g * 0.42;
                                const gx = -hx * Math.cos(spread) + px * side * Math.sin(spread);
                                const gy = -hy * Math.cos(spread) + py * side * Math.sin(spread);
                                const bx = head.x + px * side * 6 * this.scale - hx * 2 * this.scale;
                                const by = head.y + py * side * 6 * this.scale - hy * 2 * this.scale;
                                const len = (11 - g * 1.5) * this.scale;
                                const tx = bx + gx * len;
                                const ty = by + gy * len;
                                p.line(bx, by, tx, ty);
                                // feathery tips
                                p.push();
                                p.noStroke();
                                p.fill(this.gillHue, 70, 100, 0.9);
                                p.circle(tx, ty, 3.2 * this.scale);
                                p.circle(
                                    bx + gx * len * 0.62,
                                    by + gy * len * 0.62,
                                    2.4 * this.scale,
                                );
                                p.pop();
                            }
                        }

                    }
                }

                p.setup = () => {
                    sizeToContainer();
                    const cnv = p.createCanvas(W, H);
                    cnv.parent(mount);
                    p.colorMode(p.HSB, 360, 100, 100, 1);
                    for (let i = 0; i < 4; i++) axolotls.push(new Axolotl());
                };

                p.windowResized = () => {
                    sizeToContainer();
                    p.resizeCanvas(W, H);
                };

                p.draw = () => {
                    p.background(0, 0, 100, 0.25); // white w/ motion trails
                    for (const a of axolotls) {
                        a.update();
                        a.draw();
                    }
                    p.drawingContext.shadowBlur = 0;
                };

                p.mousePressed = () => {
                    if (
                        p.mouseX >= 0 &&
                        p.mouseX <= W &&
                        p.mouseY >= 0 &&
                        p.mouseY <= H &&
                        axolotls.length < MAX_AXOLOTLS
                    ) {
                        // a baby is born where you click, and grows with time
                        axolotls.push(new Axolotl(p.mouseX, p.mouseY, 0.3));
                    }
                };
            };

            new window.p5(sketch);
        })();
    </script>
</Layout>
